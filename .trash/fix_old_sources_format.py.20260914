#!/usr/bin/env python3
"""批量转换旧格式sources为标准OKF格式"""
import os
import re

# 科目配置
COURSES = {
    '财管': {
        'base': '/Users/wenjiechen/Desktop/高顿/CPA/【VIPCPA专享】名师专业课-财管/知识详解',
        'source_map': {
            '李晶_【26考季】严控定制-财管（全一册）0420更新版_OCR.md': {
                'id': 'handout-lijing-finance',
                'resource': '原始资源/notes/【全面精讲】26考季/【2026-财管-全面精讲】/李晶_【26考季】严控定制-财管（全一册）0420更新版_OCR.md',
                'teacher': '李晶',
                'course_name': '财管'
            }
        }
    },
    '税法': {
        'base': '/Users/wenjiechen/Desktop/高顿/CPA/【VIPCPA专享】名师专业课-税法/知识详解',
        'source_map': {
            '其他_【26考季】严控定制-税法-高蒙（全一册）0322_OCR.md': {
                'id': 'handout-gaomeng-tax',
                'resource': '原始资源/notes/【全面精讲】26考季/【2026-税法-全面精讲-高蒙】/其他_【26考季】严控定制-税法-高蒙（全一册）0322_OCR.md',
                'teacher': '高蒙',
                'course_name': '税法'
            }
        }
    }
}

def parse_old_sources(fm_text):
    """解析旧格式sources，返回(讲义OCR行, 讲次行)"""
    ocr_line = None
    lecture_line = None
    in_sources = False
    for line in fm_text.split('\n'):
        if line.strip().startswith('sources:'):
            in_sources = True
            continue
        if in_sources:
            if line.strip().startswith('- ') and not line.strip().startswith('  '):
                if '讲义OCR' in line:
                    ocr_line = line.strip()
                elif '讲次' in line:
                    lecture_line = line.strip()
            elif line.strip() and not line.strip().startswith(' ') and not line.strip().startswith('-'):
                in_sources = False
    return ocr_line, lecture_line

def extract_chapter(fm_text):
    """从frontmatter提取chapter信息"""
    for line in fm_text.split('\n'):
        if line.strip().startswith('chapter:'):
            return line.strip()[len('chapter:'):].strip().strip('"').strip("'")
    return None

def convert_file(path, course_config):
    """转换单个文件的sources格式"""
    with open(path, 'r') as f:
        content = f.read()
    
    if not content.startswith('---'):
        return False, 'no frontmatter'
    
    parts = content.split('---', 2)
    if len(parts) < 3:
        return False, 'invalid frontmatter'
    
    fm = parts[1]
    
    # 检查是否是旧格式
    if 'sources:' not in fm or 'resource:' in fm[fm.index('sources:'):]:
        return False, 'already standard or no sources'
    
    ocr_line, lecture_line = parse_old_sources(fm)
    if not ocr_line:
        return False, 'no 讲义OCR line found'
    
    # 解析讲义OCR行
    # 格式: - 讲义OCR: 文件名 第XXXX-YYYY行
    ocr_match = re.match(r'-\s*讲义OCR:\s*(.+?)\s+第([\d-]+)行', ocr_line)
    if not ocr_match:
        return False, f'cannot parse 讲义OCR line: {ocr_line}'
    
    filename = ocr_match.group(1).strip()
    line_range = ocr_match.group(2).strip()
    
    # 查找source配置
    source_config = None
    for key, config in course_config['source_map'].items():
        if key in filename or filename in key:
            source_config = config
            break
    
    if not source_config:
        return False, f'no source config for filename: {filename}'
    
    # 解析讲次
    lecture = ''
    if lecture_line:
        lecture_match = re.match(r'-\s*讲次:\s*(.+)', lecture_line)
        if lecture_match:
            lecture = lecture_match.group(1).strip()
    
    # 提取chapter
    chapter = extract_chapter(fm) or ''
    
    # 构建新sources
    title_parts = [f"{source_config['teacher']}严控定制·{source_config['course_name']}全一册OCR"]
    if chapter:
        title_parts.append(chapter)
    if lecture:
        title_parts.append(f"讲次{lecture}")
    title_parts.append(f"行{line_range}")
    title = '·'.join(title_parts)
    
    new_sources = f"""sources:
  - id: {source_config['id']}
    resource: "{source_config['resource']}"
    title: "{title}\""""
    
    # 替换旧sources部分
    # 找到sources:开始到下一个顶级key（非缩进非-）
    lines = fm.split('\n')
    new_lines = []
    in_sources = False
    sources_replaced = False
    for i, line in enumerate(lines):
        if line.strip().startswith('sources:'):
            in_sources = True
            new_lines.append(new_sources)
            sources_replaced = True
            continue
        if in_sources:
            # 跳过旧sources的行（以空格或-开头的）
            if line.startswith(' ') or line.startswith('\t') or line.strip().startswith('-'):
                continue
            else:
                in_sources = False
                new_lines.append(line)
        else:
            new_lines.append(line)
    
    new_fm = '\n'.join(new_lines)
    new_content = '---' + new_fm + '---' + parts[2]
    
    with open(path, 'w') as f:
        f.write(new_content)
    
    return True, f'converted (lines {line_range})'

def main():
    total_converted = 0
    total_skipped = 0
    errors = []
    
    for course_name, config in COURSES.items():
        base = config['base']
        print(f"\n=== 处理 {course_name} ===")
        course_converted = 0
        course_skipped = 0
        
        for root, dirs, files in os.walk(base):
            for f in files:
                if not f.endswith('.md'):
                    continue
                path = os.path.join(root, f)
                success, msg = convert_file(path, config)
                if success:
                    course_converted += 1
                    print(f"  ✓ {os.path.relpath(path, base)}: {msg}")
                else:
                    course_skipped += 1
                    if 'already standard' not in msg and 'no sources' not in msg:
                        errors.append((path, msg))
        
        print(f"  {course_name}: 转换{course_converted}个, 跳过{course_skipped}个")
        total_converted += course_converted
        total_skipped += course_skipped
    
    print(f"\n=== 总计 ===")
    print(f"转换: {total_converted}个")
    print(f"跳过: {total_skipped}个")
    if errors:
        print(f"错误: {len(errors)}个")
        for path, msg in errors:
            print(f"  ✗ {path}: {msg}")

if __name__ == '__main__':
    main()
